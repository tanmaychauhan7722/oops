#include<iostream>
#include<string>
using namespace std;
class area1{
    public:
    void area(int a){
        cout<<a*a<<endl;
        return;
    }
    void area(int l,int b){
        cout<<l*b<<endl;
        return;
    }
};
int main(){
    int a;
    int l,b;
    cin>>a>>l>>b;
    area1 a1;
    a1.area(a);
    a1.area(l,b);
}

